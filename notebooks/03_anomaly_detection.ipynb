import pandas as pd

df = pd.read_csv("data/clean_supply_chain.csv")

avg_days = df["shipping_days"].mean()
std_days = df["shipping_days"].std()

df["delay_anomaly"] = df["shipping_days"] > avg_days + (2 * std_days)

anomalies = df[df["delay_anomaly"] == True]

anomalies[[
    "order_id",
    "order_region",
    "shipping_mode",
    "shipping_days",
    "delivery_status"
]].head()

anomalies.to_csv("data/delay_anomalies.csv", index=False)
