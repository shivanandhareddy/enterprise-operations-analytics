from pyspark.sql import SparkSession
from pyspark.sql.functions import col, sum, count, avg

spark = SparkSession.builder.appName("SupplyChainAnalytics").getOrCreate()

df = spark.read.csv("data/clean_supply_chain.csv", header=True, inferSchema=True)

region_kpi = df.groupBy("order_region").agg(
    sum("sales").alias("total_sales"),
    count("order_id").alias("total_orders"),
    avg("shipping_days").alias("avg_shipping_days")
)

region_kpi.show()

region_kpi.write.mode("overwrite").csv("data/region_kpi_output")
